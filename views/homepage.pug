doctype html
html 
    head 
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body    
        h1 Custom Object Table
        p
            a(href="/update-cobj") Add / Update this table
        table
            thead
                tr
                    th Name
                    th Publisher
                    th Price
            tbody
                each item in data
                    tr
                        td= item.properties.name
                        td= item.properties.publisher
                        td= item.properties.price
